<?xml version="1.0" encoding="utf-8"?>
<!-- Only the app's JSON data is backed up. Shared preferences hold the API key, encrypted with a device-bound key
     that a backup could never decrypt, so they are deliberately not included. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="data/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="data/" />
    </device-transfer>
</data-extraction-rules>
